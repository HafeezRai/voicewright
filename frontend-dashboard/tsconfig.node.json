{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    /* NOTE: a project referenced via `references` must NOT set `noEmit`
       (TS6310). This project therefore emits its build info next to the config;
       the emitted files are gitignored via *.tsbuildinfo / dist. */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
