# Triton model config — NLU primary (Laya ModernBERT-large encoder).
#
# Artifact : mlops-pipeline/export/artifacts/laya_encoder.onnx  (~1.6 GiB fp32)
# Verified : I/O signature read from the real graph via ONNX Runtime.
#
# Only the encoder body is served here. Laya's RL policy head (act_head /
# scorer, ~36 small tensors) and its `temperature` scalar stay in the client —
# they are cheap and stateful, and keeping them client-side avoids re-uploading
# them per request. See ai-engine/README.md "Phase 5 (Triton) export paths".
#
# Dims: batch dim omitted (max_batch_size > 0) — exported [batch, seq] ->
# declared [-1] ; [batch, seq, 1024] -> [-1, 1024].
name: "laya_encoder"

backend: "onnxruntime"
# The graph is memory-heavy (~6.4 GiB of fp32 activations at seq 512 across a
# full batch), which is why the batch ceiling is small and the queue delay long:
# a big batch is worth waiting for, but only a modest one fits.
max_batch_size: 8

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]

output [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ -1, 1024 ]    # hidden_size = 1024 for ModernBERT-large
  }
]

dynamic_batching {
  preferred_batch_size: [ 2, 4, 8 ]
  max_queue_delay_microseconds: 4000
}

# KIND_GPU is expected here: this is the one model in the repo whose CPU latency
# (~136 ms/decision per ai-engine/README.md) genuinely motivates Triton + GPU.
instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
