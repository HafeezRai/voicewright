# =============================================================================
# CloudPSO Voice Agent — environment template
# Copy to `.env` (which is gitignored) and adjust. Every variable below is read
# by either docker-compose.yml or the per-service config modules
# (backend-core/app/config.py, ai-engine/app/config.py).
# =============================================================================

# ---- Shared config prefix ---------------------------------------------------
# Application-wide grouping / environment identity. Consumed by both services.
CLOUDEPSO_ENV=development                 # deployment environment: development|staging|production
CLOUDEPSO_LOG_LEVEL=INFO                  # root log level: DEBUG|INFO|WARNING|ERROR|CRITICAL
CLOUDEPSO_CONFIG_PREFIX=cloudpso          # namespace prefix for keys/backends shared across services

# ---- backend-core -----------------------------------------------------------
BACKEND_CORE_HOST=0.0.0.0                 # bind address for the backend-core HTTP/WS server
BACKEND_CORE_PORT=8000                    # host port published for backend-core
BACKEND_CORE_GRPC_PORT=50051              # host port published for backend-core gRPC

# ---- backend-core: audio / VAD / barge-in (Phase 2) -------------------------
BACKEND_CORE_AUDIO_SAMPLE_RATE=16000      # normalised sample rate for VAD frames (Hz)
BACKEND_CORE_VAD_FRAME_SAMPLES=512        # samples per VAD frame (512 = 32 ms @16 kHz; Silero requires this)
BACKEND_CORE_VAD_BACKEND=silero           # silero (real ONNX model) | energy (deterministic RMS fallback)
BACKEND_CORE_VAD_MODEL_PATH=              # empty => use packaged app/audio/models/silero_vad.onnx
BACKEND_CORE_VAD_THRESHOLD=0.5            # speech probability threshold for the Silero backend
BACKEND_CORE_BARGEIN_ENABLED=true         # allow user speech to interrupt agent playback
BACKEND_CORE_BARGEIN_MIN_SPEECH_MS=200    # continuous speech required before barge-in fires
BACKEND_CORE_BARGEIN_MIN_SILENCE_MS=400   # sustained silence that ends the user's turn
BACKEND_CORE_WEBRTC_STUN_SERVER=          # empty => host candidates only (local dev)
BACKEND_CORE_GRPC_ENABLED=true            # start the gRPC VoiceGateway server in-process

# ---- ai-engine --------------------------------------------------------------
AI_ENGINE_HOST=0.0.0.0                    # bind address for the ai-engine HTTP server
AI_ENGINE_PORT=8001                       # host port published for ai-engine
AI_ENGINE_MODEL_CACHE=/models             # in-container path where model weights are cached
AI_ENGINE_LAZY_MODELS=true                # load weights on first use, not at startup
AI_ENGINE_DEVICE=cpu                      # cpu | cuda | mps (STT + embedder only; the LLM picks its own backend)

# ---- ai-engine: gRPC (VoiceGateway contract, port 50052) --------------------
AI_ENGINE_GRPC_ENABLED=true               # start the gRPC VoiceGateway server in-process
AI_ENGINE_GRPC_PORT=50052                 # host port published for ai-engine gRPC

# ---- ai-engine: STT (Phase 3) -----------------------------------------------
AI_ENGINE_STT_BACKEND=faster-whisper      # faster-whisper (CTranslate2; no torch in the path)
AI_ENGINE_STT_MODEL=base.en               # Whisper size/language; *.en is English-only
AI_ENGINE_STT_COMPUTE_TYPE=int8           # int8 on CPU, float16 on GPU
AI_ENGINE_STT_BEAM_SIZE=1                 # 1 = greedy (fastest); raise for accuracy

# ---- ai-engine: LLM (the "think" stage) -------------------------------------
# The intent classifier is gone; replies are generated. One OpenAI-compatible
# client covers every provider (Ollama, DeepSeek, vLLM, LM Studio, OpenAI) --
# the provider name only selects a default base URL, so a new host needs no code.
AI_ENGINE_LLM_PROVIDER=ollama             # ollama | deepseek | openai | ...
AI_ENGINE_LLM_BASE_URL=                   # blank => derived from the provider
AI_ENGINE_LLM_MODEL=llama3:8b             # exact Ollama tag; bare `llama3` 404s
AI_ENGINE_LLM_API_KEY=                    # bearer token; blank for a local Ollama
# The MiniLM encoder that outlived the intent model: the knowledge-base (RAG)
# retrieval primitive. Not on the reply path today.
AI_ENGINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- ai-engine: TTS (Phase 3) -----------------------------------------------
AI_ENGINE_TTS_BACKEND=sherpa              # sherpa-onnx (Apache-2.0); runs Piper VITS voices
AI_ENGINE_TTS_MODEL=vits-piper-en_US-amy-low  # voice dir under <models>/tts
AI_ENGINE_TTS_SPEAKER_ID=0                # multi-speaker voice selection
AI_ENGINE_TTS_SPEED=1.0                   # 0 < speed <= 4
AI_ENGINE_TTS_CHUNK_SAMPLES=3200          # PCM chunk size the pipeline streams (3200 = 200 ms @16 kHz)

# ---- frontend-dashboard (Phase 4) -------------------------------------------
FRONTEND_DASHBOARD_PORT=5173              # host port for the Vite dev server / preview
# Browser-reachable service base URLs. VITE_BACKEND_URL is the Phase 4 name;
# VITE_BACKEND_CORE_URL is still honoured for continuity with the Phase 1 scaffold.
# Prefer the 127.0.0.1 literal: with Docker Desktop running, `localhost` resolves
# to ::1 first and a published container can occupy that port.
VITE_BACKEND_CORE_URL=http://127.0.0.1:8000   # browser-reachable backend-core base URL
VITE_BACKEND_URL=http://127.0.0.1:8000        # preferred alias (wins if both set)
VITE_AI_ENGINE_URL=http://127.0.0.1:8001      # browser-reachable ai-engine base URL
VITE_METRICS_POLL_MS=2000                 # dashboard /metrics poll interval (ms)
VITE_METRICS_HISTORY=60                   # samples kept in the live time-series

# ---- CORS (Phase 4) ---------------------------------------------------------
# Comma-separated browser origins allowed to call backend-core AND ai-engine.
# Defaults to the local dashboard only. NEVER set this to "*" outside a sandbox.
CLOUDEPSO_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Prometheus -------------------------------------------------------------
PROMETHEUS_PORT=9090                      # host port for the Prometheus UI/API
PROMETHEUS_SCRAPE_INTERVAL=15s            # default scrape interval
