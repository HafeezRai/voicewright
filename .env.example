# =============================================================================
# CloudPSO Voice Agent — environment template
# Copy to `.env` (which is gitignored) and adjust. Every variable below is read
# by either docker-compose.yml or the per-service config modules
# (backend-core/app/config.py, ai-engine/app/config.py).
# =============================================================================

# ---- Shared config prefix ---------------------------------------------------
# Application-wide grouping / environment identity. Consumed by both services.
CLOUDEPSO_ENV=development                 # deployment environment: development|staging|production
CLOUDEPSO_LOG_LEVEL=INFO                  # root log level: DEBUG|INFO|WARNING|ERROR|CRITICAL
CLOUDEPSO_CONFIG_PREFIX=cloudpso          # namespace prefix for keys/backends shared across services

# ---- backend-core -----------------------------------------------------------
BACKEND_CORE_HOST=0.0.0.0                 # bind address for the backend-core HTTP/WS server
BACKEND_CORE_PORT=8000                    # host port published for backend-core
BACKEND_CORE_GRPC_PORT=50051              # host port published for backend-core gRPC

# ---- backend-core: audio / VAD / barge-in (Phase 2) -------------------------
BACKEND_CORE_AUDIO_SAMPLE_RATE=16000      # normalised sample rate for VAD frames (Hz)
BACKEND_CORE_VAD_FRAME_SAMPLES=512        # samples per VAD frame (512 = 32 ms @16 kHz; Silero requires this)
BACKEND_CORE_VAD_BACKEND=silero           # silero (real ONNX model) | energy (deterministic RMS fallback)
BACKEND_CORE_VAD_MODEL_PATH=              # empty => use packaged app/audio/models/silero_vad.onnx
BACKEND_CORE_VAD_THRESHOLD=0.5            # speech probability threshold for the Silero backend
BACKEND_CORE_BARGEIN_ENABLED=true         # allow user speech to interrupt agent playback
BACKEND_CORE_BARGEIN_MIN_SPEECH_MS=200    # continuous speech required before barge-in fires
BACKEND_CORE_BARGEIN_MIN_SILENCE_MS=400   # sustained silence that ends the user's turn
BACKEND_CORE_WEBRTC_STUN_SERVER=          # empty => host candidates only (local dev)
BACKEND_CORE_GRPC_ENABLED=true            # start the gRPC VoiceGateway server in-process

# ---- ai-engine --------------------------------------------------------------
AI_ENGINE_HOST=0.0.0.0                    # bind address for the ai-engine HTTP server
AI_ENGINE_PORT=8001                       # host port published for ai-engine
AI_ENGINE_MODEL_CACHE=/models             # in-container path where model weights are cached

# ---- frontend-dashboard -----------------------------------------------------
FRONTEND_DASHBOARD_PORT=5173              # host port for the Vite dev server / preview
VITE_BACKEND_CORE_URL=http://localhost:8000   # browser-reachable backend-core base URL

# ---- Prometheus -------------------------------------------------------------
PROMETHEUS_PORT=9090                      # host port for the Prometheus UI/API
PROMETHEUS_SCRAPE_INTERVAL=15s            # default scrape interval
